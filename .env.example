# Railway Variables for your store.
# Add these in Railway: your web service > Variables > Raw Editor.
# Never put real values in this file or anywhere in GitHub.

# ── Required ──────────────────────────────────────────────
# Links the Postgres database. Type it exactly like this.
DATABASE_URL=${{Postgres.DATABASE_URL}}
# Your admin login. The account is created the first time the store starts.
ADMIN_EMAIL=you@yourstore.com
ADMIN_PASSWORD=change-me-to-something-long
# Makes the sign-in cookie HTTPS-only.
NODE_ENV=production
# Your store's address, no slash at the end.
PUBLIC_URL=https://yourstore.com

# ── Payments: stripe, manual or custom ────────────────────
PAYMENT_PROVIDER=stripe
# sk_test_... while testing, sk_live_... when you launch
STRIPE_SECRET_KEY=
# whsec_... from your Stripe webhook
STRIPE_WEBHOOK_SECRET=

# ── Emails (optional, recommended) ────────────────────────
RESEND_API_KEY=
EMAIL_FROM=Your Store <orders@yourstore.com>
# Where new-order alerts go. Defaults to ADMIN_EMAIL.
NOTIFY_EMAIL=you@yourstore.com

# ── Switches (optional) ───────────────────────────────────
# true shows an "Opening soon" page to everyone except signed-in admins
COMING_SOON=false
# false starts the store with no demo products
SEED_DEMO=true
# Preview another theme without editing store.config.js:
# clean, warm, midnight, editorial, soft, bold or luxe
# THEME=warm
# Preview a color preset the same way:
# ink, cobalt, forest, terracotta, plum, ocean, rose or gold
# PALETTE=forest
# Time zone for reports and the monthly email (default America/Los_Angeles)
# STORE_TZ=America/New_York
# Background jobs (holds, reminders, emails) run in the web process.
# Set JOBS=off only on extra copies if you ever run more than one.
# JOBS=on
